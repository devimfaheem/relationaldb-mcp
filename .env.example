# Required — generate each with: openssl rand -hex 32
API_KEY=
SECRET_KEY=
# Required — at least 8 characters
ADMIN_PASSWORD=

# Optional
ADMIN_USERNAME=admin
PORT=3000
DATA_DIR=/data
# Accept the API key as ?key=... (needed for claude.ai custom connectors). Keys in URLs can end up in logs.
ALLOW_QUERY_KEY=false
# Set to true when running behind a reverse proxy (Caddy, Traefik, nginx) that terminates TLS
TRUST_PROXY=false
LOG_LEVEL=info

# Used by the example connections in examples/data via ${...} references
DEMO_MYSQL_PASSWORD=mcp_password
DEMO_POSTGRES_PASSWORD=mcp_password
DEMO_MSSQL_PASSWORD=Mcp_password1
